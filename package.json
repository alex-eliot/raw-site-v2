{
  "name": "raw-downloader",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:extensions && pnpm copy:extension:zips && pnpm --filter raw-site build",
    "build:site": "pnpm --filter raw-site build",
    "build:extensions": "pnpm zip:extension && pnpm zip:extension:firefox",
    "copy:extension:zips": "node scripts/copy-extension-zips.mjs",
    "dev": "pnpm --filter raw-site dev",
    "generate": "pnpm --filter raw-site generate",
    "preview": "pnpm --filter raw-site preview",
    "typecheck": "pnpm --filter raw-site typecheck",
    "serve:build": "pnpm --filter raw-site serve:build",
    "start": "pm2 start ecosystem.config.cjs",
    "reload": "pm2 startOrReload ecosystem.config.cjs --update-env",
    "stop": "pm2 delete raw-site",
    "logs": "pm2 logs raw-site",
    "dev:extension": "pnpm --filter extension dev",
    "dev:extension:firefox": "pnpm --filter extension dev:firefox",
    "build:extension": "pnpm --filter extension build",
    "build:extension:firefox": "pnpm --filter extension build:firefox",
    "zip:extension": "pnpm --filter extension zip",
    "zip:extension:firefox": "pnpm --filter extension zip:firefox",
    "typecheck:extension": "pnpm --filter extension typecheck",
    "build:all": "pnpm -r build",
    "typecheck:all": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "pm2": "^7.1.2"
  }
}
